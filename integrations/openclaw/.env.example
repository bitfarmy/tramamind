# ── TramaMind × OpenClaw — copia in .env e compila (MAI committare .env) ──

# Token del bot Telegram: crealo con @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Token di accesso al gateway OpenClaw (dashboard + API)
# Genera con: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Il tuo chat ID Telegram (dopo il primo pairing, per restringere l'accesso)
# TELEGRAM_ALLOW_FROM=
