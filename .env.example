# TramaMind non legge le chiavi da questo file.
# Le chiavi stanno nel keyring: `tramamind keys add groq`
# Questo file documenta solo le variabili che il compose opzionale capisce.

# Heap di OmniRoute per la chat. Non alzarlo a 8 GB sul nodo da 24 GB.
OMNIROUTE_MEMORY_MB=1024

# Solo se usi il profilo compose "agent".
OPENHANDS_MODEL=openai/auto
WORKSPACE_BASE=./workspace
