# TramaMind — configurazione locale (copia in .env e compila)
# Il file .env è gitignored: le chiavi non finiscono mai nel repo.
# start-all.sh carica questo file prima di avviare OmniRoute.

# Provider a pagamento/basso costo
KIMI_API_KEY=

# Provider gratuiti (lascia vuoti quelli che non usi)
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Override opzionali per chat.sh
#TRAMAMIND_ENDPOINT=http://localhost:20128/v1/chat/completions
#TRAMAMIND_MODEL=auto
#TRAMAMIND_TIMEOUT=120
