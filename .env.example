# ==========================================================================
# TramaMind — variabili d'ambiente
# Copia in .env e compila. .env e' gitignored: MAI committare chiavi reali.
# Le chiavi vanno inserite ANCHE nella dashboard di OmniRoute
# (http://localhost:20128 → Providers): e' li' che il router le usa.
# ==========================================================================

# ---------- Provider ----------
KIMI_API_KEY=            # Kimi via API      https://platform.moonshot.ai

# Provider gratuiti (lascia vuoti quelli che non usi)
GOOGLE_API_KEY=          # Google AI Studio  https://aistudio.google.com
GROQ_API_KEY=            # Groq              https://console.groq.com
NVIDIA_API_KEY=          # NVIDIA NIM        https://build.nvidia.com
CEREBRAS_API_KEY=        # Cerebras          https://cloud.cerebras.ai
OPENROUTER_API_KEY=      # OpenRouter        https://openrouter.ai

# ---------- Client → OmniRoute ----------
# Chiave generata da Dashboard OmniRoute → Endpoints.
# La usano chat.sh e OpenHands per parlare con il router.
OMNIROUTE_API_KEY=

# ---------- OpenHands (L-APP, opzionale) ----------
# Modello lato OmniRoute: "openai/auto" = smart routing del router.
# Per forzare un locale: "openai/qwen2.5-coder:7b" ecc. (prefisso openai/
# obbligatorio: istruisce LiteLLM a parlare OpenAI-compatible).
OPENHANDS_MODEL=openai/auto
# Directory di lavoro dell'agente (montata nel sandbox Docker)
WORKSPACE_BASE=./workspace

# ---------- Risorse ----------
# Workload agentico: heap V8 8 GB (il default 1 GB va in FATAL ERROR
# con contesti lunghi da agenti di coding)
OMNIROUTE_MEMORY_MB=8192

# ---------- Override opzionali per chat.sh ----------
#TRAMAMIND_ENDPOINT=http://localhost:20128/v1/chat/completions
#TRAMAMIND_MODEL=auto
#TRAMAMIND_TIMEOUT=120
#ALIAS_CODE=qwen2.5-coder:7b
#ALIAS_THINK=deepseek-r1:8b
#ALIAS_FAST=gemma3:4b
#ALIAS_WRITE=qwen3:8b

# NOTA: la compressione (L2) e' integrata in OmniRoute — nessun proxy
# separato, nessuna porta extra. Si attiva da Dashboard → Compression.
# Claude Pro (L3A) NON compare qui: solo Claude Code CLI / claude.ai,
# mai dietro il router.
